<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Stonecutter: reform mixed stone blocks or Miho ceramic into one chosen block type (1:1). -->

  <RecipeDef>
    <defName>StoneRefining_ReformToGranite</defName>
    <label>Reform blocks into granite blocks (x1)</label>
    <description>Turn 1 limestone, marble, sandstone, slate, or Miho ceramic block into 1 granite block.</description>
    <jobString>Reforming stone blocks.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>CutStone</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
    <workAmount>120</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>BlocksLimestone</li>
            <li>BlocksMarble</li>
            <li>BlocksSandstone</li>
            <li>BlocksSlate</li>
            <li MayRequire="miho.fortifiedoutremer">Miho_Ceramics</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BlocksLimestone</li>
        <li>BlocksMarble</li>
        <li>BlocksSandstone</li>
        <li>BlocksSlate</li>
        <li MayRequire="miho.fortifiedoutremer">Miho_Ceramics</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <BlocksGranite>1</BlocksGranite>
    </products>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.05</workSkillLearnFactor>
    <recipeUsers>
      <li>TableStonecutter</li>
    </recipeUsers>
  </RecipeDef>

