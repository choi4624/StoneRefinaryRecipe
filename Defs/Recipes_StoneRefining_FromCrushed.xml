<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Refine crushed stone into metal. -->
  <RecipeDef>
    <defName>StoneRefining_CrushedToSteel</defName>
    <label>Extract steel from crushed stone</label>
    <description>Smelt crushed stone to recover steel.</description>
    <jobString>Extracting steel.</jobString>
    <workSpeedStat>ResearchSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>200</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>StoneRefining_CrushedStone</li>
          </thingDefs>
        </filter>
        <count>80</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>StoneRefining_CrushedStone</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Steel>15</Steel>
    </products>
    <skillRequirements>
      <Intellectual>5</Intellectual>
    </skillRequirements>
    <workSkill>Intellectual</workSkill>
    <workSkillLearnFactor>0.35</workSkillLearnFactor>
    <recipeUsers>
      <li>ElectricSmelter</li>
      <li>Miho_CelestialForge</li>
      <li>Miho_ShaftFurnace</li>
    </recipeUsers>
  </RecipeDef>

