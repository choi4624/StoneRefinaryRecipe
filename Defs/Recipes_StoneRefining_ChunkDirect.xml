<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Direct chunk-to-metal at Miho celestial forge only. -->
  <RecipeDef>
    <defName>StoneRefining_ChunkToSteelDirect</defName>
    <label>Extract steel from stone chunks</label>
    <description>Smelt stone chunks at high heat to recover steel without crushing first.</description>
    <jobString>Extracting steel from chunks.</jobString>
    <workSpeedStat>ResearchSpeed</workSpeedStat>
    <efficiencyStat>MiningYield</efficiencyStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>2080</workAmount>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>StoneChunks</li>
          </categories>
        </filter>
        <count>8</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>StoneChunks</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <Steel>75</Steel>
    </products>
    <skillRequirements>
      <Intellectual>6</Intellectual>
    </skillRequirements>
    <workSkill>Intellectual</workSkill>
    <workSkillLearnFactor>0.35</workSkillLearnFactor>
    <recipeUsers>
      <li>Miho_CelestialForge</li>
    </recipeUsers>
  </RecipeDef>

