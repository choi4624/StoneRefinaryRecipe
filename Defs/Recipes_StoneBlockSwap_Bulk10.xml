<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Stonecutter: bulk 10 reform. Same inputs as x1 recipes, 10:10. -->

  <RecipeDef>
    <defName>StoneRefining_ReformToGranite_Bulk10</defName>
    <label>Reform blocks into granite blocks (x10)</label>
    <description>Turn 10 limestone, marble, sandstone, slate, or Miho ceramic blocks into 10 granite blocks.</description>
    <jobString>Reforming stone blocks.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>CutStone</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
    <workAmount>1200</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>BlocksLimestone</li>
            <li>BlocksMarble</li>
            <li>BlocksSandstone</li>
            <li>BlocksSlate</li>
            <li>Miho_Ceramics</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>BlocksLimestone</li>
        <li>BlocksMarble</li>
        <li>BlocksSandstone</li>
        <li>BlocksSlate</li>
        <li>Miho_Ceramics</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <BlocksGranite>10</BlocksGranite>
    </products>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.05</workSkillLearnFactor>
    <recipeUsers>
      <li>TableStonecutter</li>
    </recipeUsers>
  </RecipeDef>

